{
  "name": "lok-sewa-sathi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nepal civil service (Lok Sewa) exam preparation app for Adhikrit, Nayab Subba and Kharidar - bilingual English/Nepali",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test:data": "tsx scripts/validate-data.ts",
    "test:scoring": "tsx scripts/test-scoring.ts",
    "test": "npm run test:data && npm run test:scoring && npm run test:materials && npm run test:streak && npm run test:android-strings",
    "export:content": "tsx scripts/export-content.ts",
    "test:android-strings": "python3 scripts/check-android-strings.py",
    "test:materials": "tsx scripts/test-materials.ts",
    "test:streak": "tsx scripts/test-streak.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
