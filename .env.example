# The published library. Leave this file unused and the app runs a preview
# library that stores files in the browser only — see docs/PUBLISHING.md.
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit it.
#
# The anon key is meant to be public and ships in the bundle. It identifies
# the project and authorises nothing: what allows or refuses a write is the
# row-level security policy at Supabase. NEVER put a service-role key here —
# it bypasses every policy.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_SUPABASE_BUCKET=materials
